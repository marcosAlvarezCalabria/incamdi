---
import { navItems } from '@/domain/content';
import { brandNameHtml } from '@/domain/brand';
import Bilingual from './ui/Bilingual.astro';
import Logo from './ui/Logo.astro';

const isEnglish = Astro.url.pathname.startsWith('/en');
const homePath = isEnglish ? '/en/' : '/';
const privacyPath = isEnglish ? '/en/privacy/' : '/privacidad/';
const cookiesPath = isEnglish ? '/en/cookies/' : '/cookies/';
---

<footer>
  <div class="foot-in">
    <Logo compact href={homePath} />
    <nav class="foot-links" aria-label={isEnglish ? 'Footer navigation' : 'Navegación del pie'}>
      {navItems.map((item) => <Bilingual tag="a" href={`${homePath}${item.href}`} es={item.label.es} en={item.label.en} />)}
      <Bilingual tag="a" href={`${homePath}#contacto`} es="Contacto" en="Contact" />
    </nav>
    <nav class="foot-legal" aria-label={isEnglish ? 'Legal information' : 'Información legal'}>
      <a href={privacyPath}>{isEnglish ? 'Privacy' : 'Privacidad'}</a>
      <a href={cookiesPath}>Cookies</a>
      <button class="foot-cookie-settings" type="button" data-cookie-settings>
        {isEnglish ? 'Cookie settings' : 'Configurar cookies'}
      </button>
    </nav>
    <Bilingual
      tag="p"
      class="foot-copy"
      es={`© 2026 ${brandNameHtml()} · Desarrollo web, SEO y automatizaciones a medida · Hecho en Galway 🔥`}
      en={`© 2026 ${brandNameHtml()} · Web development, SEO and custom automation · Made in Galway 🔥`}
    />
  </div>
</footer>
