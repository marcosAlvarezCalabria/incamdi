---
import { services } from '@/domain/content';
import { serviceHref, servicePages } from '@/domain/service-pages';
import Bilingual from './ui/Bilingual.astro';
import Icon from './ui/Icon.astro';
const language = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
---

<section id="servicios" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-label rv"><Bilingual es="Servicios" en="Services" /></div>
    <div class="head-2col rv">
      <div>
        <Bilingual tag="p" class="kicker" es="Lo que hago por tu negocio" en="What I do for your business" />
        <Bilingual
          tag="h2"
          class="title"
          id="services-title"
          es="Todo lo digital de tu negocio, bajo un mismo techo."
          en="All your digital, under one roof."
        />
      </div>
      <Bilingual
        tag="p"
        es="Desde la web que te representa hasta el software que automatiza tu operativa. Trabajas directamente con quien lo construye."
        en="From the website that represents you to the software that runs your operation. You work directly with the person who builds it."
      />
    </div>
    <div class="grid-auto services-grid">
      {services.map((service, index) => (
        <a class="card service-card rv" href={serviceHref(servicePages[index], language)}>
          <div class="card-top">
            <div class="ic"><Icon name={service.icon} /></div>
            <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <Bilingual tag="h3" es={service.title.es} en={service.title.en} />
          <Bilingual tag="p" es={service.description.es} en={service.description.en} />
          <span class="service-card__link"><Bilingual es="Explorar servicio" en="Explore service" /><Icon name="arrow" size={16} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .service-card{display:flex;flex-direction:column}.service-card p{flex:1}.service-card__link{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:22px;border-top:1px solid var(--line);padding-top:16px;color:var(--accent-deep);font-size:.875rem;font-weight:600}
</style>
