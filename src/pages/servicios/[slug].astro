---
import ServiceDetail from '@/components/ServiceDetail.astro';
import { servicePages, type ServicePage } from '@/domain/service-pages';

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug.es },
    props: { service },
  }));
}

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
---

<ServiceDetail service={service} language="es" />
